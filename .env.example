# cybercheck environment. Copy to .env and fill in. Never commit .env.

# --- Core ---
DATABASE_URL=postgres://cybercheck:cybercheck_dev@localhost:5433/cybercheck
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL of the website (the web app forwards /api/auth/* to the API)
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# Proxies in front of the API (comma-separated IPs/CIDRs). Add your load balancer in production.
TRUSTED_PROXIES=127.0.0.1,::1
# Where the web app finds the API (used by Next.js rewrites)
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Google sign-in (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub App: sign-in + read-only repository import (optional) ---
# GitHub > Settings > Developer settings > GitHub Apps > New GitHub App (use its Client ID/secret)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The GitHub App URL name: github.com/apps/<slug>. Enables "Import from GitHub".
GITHUB_APP_SLUG=

# --- Email codes via Gmail SMTP (optional; without it codes print in the API terminal) ---
# Requires 2-Step Verification on the Gmail account, then create an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
