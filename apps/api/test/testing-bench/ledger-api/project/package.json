    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "fastify": "5.6.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
