{
  "name": "tripdesk",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @tripdesk/core && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @tripdesk/api"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
