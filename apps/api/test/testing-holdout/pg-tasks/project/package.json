    "pg": "8.16.3"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.test.js"]
  }
}
