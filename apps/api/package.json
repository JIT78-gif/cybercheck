{
  "name": "@cybercheck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "auth:schema": "npx @better-auth/cli@latest generate --config src/auth/auth.ts --output src/db/auth-schema.ts --yes",
    "test": "vitest run",
    "eval:understanding": "node --env-file-if-exists=../../.env --import tsx scripts/eval-understanding.ts",
    "worker": "tsx watch --include ../../.env --env-file-if-exists=../../.env src/worker.ts",
    "worker:start": "node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "eval:testing": "node --env-file-if-exists=../../.env --import tsx scripts/eval-testing.ts",
    "eval:security": "node --env-file-if-exists=../../.env --import tsx scripts/eval-security.ts",
    "eval:ai": "node --env-file-if-exists=../../.env --import tsx scripts/eval-ai.ts",
    "eval:ai:live": "node --env-file-if-exists=../../.env --import tsx scripts/eval-ai-live.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@cybercheck/contracts": "^0.1.0",
    "@fastify/multipart": "^10.1.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "smol-toml": "1.9.1",
    "tar-stream": "^3.2.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  }
}
